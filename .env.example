# =========================================================================
# KrishiDristi Pro - Frontend Environment Variables Template
# Copy this file to '.env' or '.env.local' in this directory and populate
# with your actual Firebase project settings.
# =========================================================================

# --- Firebase Client SDK Configuration Keys ---
# Retrieve these values from your Firebase Project Console -> Project Settings -> General
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=1:your_app_id_here

# --- Simulation & Development Overrides ---
# Optional: Set to 'true' to force simulation mode even if firebase keys are configured.
# VITE_FORCE_SIMULATION_MODE=false
